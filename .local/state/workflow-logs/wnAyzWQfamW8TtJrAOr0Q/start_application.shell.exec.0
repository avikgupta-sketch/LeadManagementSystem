[39;49m[39;49m[96mSELECT "l"."Id", "l"."AssignedAgentId", "l"."CreatedById", "l"."CreatedDate", "l"."Description", "l"."IsDeleted", "l"."ManagerId", "l"."RowVersion", "l"."Status", "l"."Title", "l"."UpdatedById", "l"."UpdatedDate", "t"."Id", "t"."AccessFailedCount", "t"."ConcurrencyStamp", "t"."Email", "t"."EmailConfirmed", "t"."FullName", "t"."IsDeleted", "t"."LockoutEnabled", "t"."LockoutEnd", "t"."ManagerId", "t"."NormalizedEmail", "t"."NormalizedUserName", "t"."PasswordHash", "t"."PhoneNumber", "t"."PhoneNumberConfirmed", "t"."SecurityStamp", "t"."TwoFactorEnabled", "t"."UserName"
