@model LMS.Models.DTOs.Dashboard.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">Dashboard</h1>
        <div class="lms-page-sub">Overview of your leads at a glance</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-3">
        <div class="lms-stat-card d-flex justify-content-between align-items-center">
            <div>
                <div class="lms-stat-label">Total Leads</div>
                <div class="lms-stat-value">@Model.TotalLeads</div>
            </div>
            <div class="lms-stat-accent" style="background:linear-gradient(135deg,#4f46e5,#06b6d4);">📋</div>
        </div>
    </div>

    @if (User.IsInRole("Manager"))
    {
        <div class="col-md-4 col-lg-3">
            <div class="lms-stat-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="lms-stat-label">My Agents</div>
                    <div class="lms-stat-value">@Model.TotalAgents</div>
                </div>
                <div class="lms-stat-accent" style="background:linear-gradient(135deg,#06b6d4,#10b981);">🧑‍💼</div>
            </div>
        </div>
    }

    <div class="col-md-4 col-lg-3">
        <div class="lms-stat-card d-flex justify-content-between align-items-center">
            <div>
                <div class="lms-stat-label">Converted</div>
                <div class="lms-stat-value">@Model.Converted</div>
            </div>
            <div class="lms-stat-accent" style="background:linear-gradient(135deg,#10b981,#34d399);">✓</div>
        </div>
    </div>

    <div class="col-md-4 col-lg-3">
        <div class="lms-stat-card d-flex justify-content-between align-items-center">
            <div>
                <div class="lms-stat-label">Open</div>
                <div class="lms-stat-value">@(Model.New + Model.InProgress + Model.FollowUp + Model.Interested)</div>
            </div>
            <div class="lms-stat-accent" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);">⏳</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Leads by Status</div>
    <div class="card-body">
        <div class="row g-3">
            @{
                var stats = new (string Label, int Count, string CssClass)[]
                {
                    ("New",            Model.New,           "lms-badge-New"),
                    ("In Progress",    Model.InProgress,    "lms-badge-InProgress"),
                    ("Follow Up",      Model.FollowUp,      "lms-badge-FollowUp"),
                    ("Interested",     Model.Interested,    "lms-badge-Interested"),
                    ("Not Interested", Model.NotInterested, "lms-badge-NotInterested"),
                    ("Converted",      Model.Converted,     "lms-badge-Converted"),
                    ("Closed",         Model.Closed,        "lms-badge-Closed"),
                    ("Rejected",       Model.Rejected,      "lms-badge-Rejected"),
                };
            }

            @foreach (var s in stats)
            {
                <div class="col-6 col-md-3">
                    <div class="d-flex justify-content-between align-items-center p-3 rounded"
                         style="border:1px solid var(--lms-border);">
                        <span class="lms-badge @s.CssClass">@s.Label</span>
                        <span style="font-weight:700; font-size:1.1rem;">@s.Count</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
