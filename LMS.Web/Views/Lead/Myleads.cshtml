@model List<LMS.Models.Entities.Lead>
@using LMS.Models.Enums

@{
    ViewData["Title"] = "My Leads";
}

<h2 class="mb-4">My Leads</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">You don't have any leads yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th style="min-width:380px">Update Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var lead in Model)
        {
            bool isTerminal = lead.Status == LeadStatus.Converted
                              || lead.Status == LeadStatus.Closed
                              || lead.Status == LeadStatus.Rejected;

            <tr>
                <td>@lead.Title</td>
                <td><span class="badge bg-secondary">@lead.Status</span></td>

                <td>
                    @if (isTerminal)
                    {
                        <span class="text-muted small">Lead is @lead.Status — no further updates allowed.</span>
                    }
                    else
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="LeadId" value="@lead.Id" />

                            <select name="NewStatus" class="form-select form-select-sm" style="max-width:140px">
                                @foreach (var status in Enum.GetValues(typeof(LeadStatus)))
                                {
                                    if ((LeadStatus)status == lead.Status)
                                    {
                                        <option value="@status" selected>@status</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@status</option>
                                    }
                                }
                            </select>

                            <input type="text" name="Remark" class="form-control form-control-sm"
                                   placeholder="Remark (required)" required />

                            <button type="submit" class="btn btn-sm btn-primary">Update</button>
                        </form>
                    }
                </td>

                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Detail" asp-route-id="@lead.Id">View</a>

                    @if (!isTerminal)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Edit" asp-route-id="@lead.Id">Edit</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
