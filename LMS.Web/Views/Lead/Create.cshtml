@model LMS.Models.DTOs.Lead.CreateLeadDto
@using LMS.Models.Enums

@{
    ViewData["Title"] = "Create Lead";
    var agents = ViewBag.Agents as List<(int Id, string Name)> ?? new List<(int, string)>();
    bool isManager = User.IsInRole("Manager");
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">Create Lead</h1>
        <div class="lms-page-sub">Add a new customer lead to the pipeline</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (isManager && !agents.Any())
{
    <div class="alert alert-warning">
        You don't have any agents yet.
        <a asp-controller="User" asp-action="Agents" class="alert-link">Create an agent</a> first.
    </div>
}

<div class="card" style="max-width:760px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" required placeholder="Customer full name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
               

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required placeholder="customer@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select" required>
                        @foreach (var g in Enum.GetValues(typeof(Gender)))
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <input asp-for="Address" class="form-control" required placeholder="Street, City, State" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required
                              placeholder="What is this lead about?"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                @if (isManager)
                {
                    <div class="col-12">
                        <label class="form-label">Assign to Agent</label>
                        <select asp-for="AssignedAgentId" class="form-select" required>
                            <option value="">-- Select Agent --</option>
                            @foreach (var agent in agents)
                            {
                                <option value="@agent.Id">@agent.Name</option>
                            }
                        </select>
                        <span asp-validation-for="AssignedAgentId" class="text-danger small"></span>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"
                        @(isManager && !agents.Any() ? "disabled" : "")>
                    Create Lead
                </button>
                <a asp-action="@(isManager ? "Index" : "MyLeads")" class="btn btn-outline-primary">Cancel</a>
            </div>
        </form>
    </div>
</div>
