@model LMS.Models.DTOs.Lead.CreateLeadDto

@{
    ViewData["Title"] = "Create Lead";
    var agents = ViewBag.Agents as List<(int Id, string Name)> ?? new List<(int, string)>();
    bool isManager = User.IsInRole("Manager");
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">Create Lead</h1>
        <div class="lms-page-sub">Add a new lead to the pipeline</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (isManager && !agents.Any())
{
    <div class="alert alert-warning">
        You don't have any agents yet.
        <a asp-controller="User" asp-action="Agents" class="alert-link">Create an agent</a> first.
    </div>
}

<div class="card" style="max-width:640px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" required placeholder="e.g. Demo with Acme Corp" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" required
                          placeholder="Brief details about this lead"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            @if (isManager)
            {
                <div class="mb-3">
                    <label class="form-label">Assign to Agent</label>
                    <select asp-for="AssignedAgentId" class="form-select" required>
                        <option value="">-- Select Agent --</option>
                        @foreach (var agent in agents)
                        {
                            <option value="@agent.Id">@agent.Name</option>
                        }
                    </select>
                    <span asp-validation-for="AssignedAgentId" class="text-danger small"></span>
                </div>
            }

            <button type="submit" class="btn btn-primary"
                    @(isManager && !agents.Any() ? "disabled" : "")>Create Lead</button>
        </form>
    </div>
</div>
