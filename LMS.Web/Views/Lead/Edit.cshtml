@model LMS.Models.DTOs.Lead.EditLeadDto

@{
    ViewData["Title"] = "Edit Lead";
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">Edit Lead</h1>
        <div class="lms-page-sub">Update title and description</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card" style="max-width:640px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                @if (User.IsInRole("Manager"))
                {
                    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
                }
                else
                {
                    <a asp-action="MyLeads" class="btn btn-outline-primary">Cancel</a>
                }
            </div>

            <p class="text-muted small mt-3 mb-0">
                Status cannot be edited here. Only Agents can change a lead's status (with a remark).
            </p>
        </form>
    </div>
</div>
