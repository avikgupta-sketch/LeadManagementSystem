@model LMS.Models.DTOs.Lead.LeadDetailDto

@{
    ViewData["Title"] = "Lead Detail";
}

<h2 class="mb-3">Lead Detail</h2>

<div class="card mb-4" style="max-width:700px">
    <div class="card-body">
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Status:</strong> <span class="badge bg-secondary">@Model.Status</span></p>
    </div>
</div>

<h4 class="mb-3">Remarks History</h4>

@if (!Model.Remarks.Any())
{
    <p class="text-muted">No remarks yet.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Old Status</th>
                <th>New Status</th>
                <th>Changed By</th>
                <th>Remark</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Remarks)
        {
            <tr>
                <td>@r.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@r.OldStatus</td>
                <td>@r.NewStatus</td>
                <td>@r.ChangedByName</td>
                <td>@r.Remark</td>
            </tr>
        }
        </tbody>
    </table>
}

<div class="mt-3">
    @if (User.IsInRole("Manager"))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Leads</a>
    }
    else if (User.IsInRole("Agent"))
    {
        <a asp-action="MyLeads" class="btn btn-outline-secondary">Back to My Leads</a>
    }
</div>
