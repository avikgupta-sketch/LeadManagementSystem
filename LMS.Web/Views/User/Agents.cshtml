@model List<LMS.Models.DTOs.User.EditUserDto>

@{
    ViewData["Title"] = "My Agents";
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">My Agents</h1>
        <div class="lms-page-sub">Build and manage your agent team</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-header">Create new Agent</div>
    <div class="card-body">
        <form asp-action="CreateAgent" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <input name="FullName" placeholder="Full Name" class="form-control" required />
            </div>
            <div class="col-md-3">
                <input name="Email" type="email" placeholder="Email" class="form-control" required />
            </div>
            <div class="col-md-3">
                <input name="Password" type="password" placeholder="Password" class="form-control" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Create Agent</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">My Team (@Model.Count)</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="p-4 text-muted mb-0 text-center">No agents yet — create one above.</p>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="lms-avatar" style="width:30px;height:30px;font-size:.75rem;">
                                    @(string.IsNullOrEmpty(a.FullName) ? "?" : a.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <span>@a.FullName</span>
                            </div>
                        </td>
                        <td class="text-muted">@a.Email</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="EditAgent" asp-route-id="@a.Id">Edit</a>

                            <form asp-action="DeleteAgent" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this agent?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
