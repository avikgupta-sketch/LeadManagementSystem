@model LMS.Models.DTOs.User.EditUserDto

@{
    ViewData["Title"] = "Edit Agent";
}

<h2 class="mb-4">Edit Agent</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card" style="max-width:480px">
    <div class="card-body">
        <form asp-action="EditAgent" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Agents" class="btn btn-outline-secondary">Cancel</a>
            </div>

            <p class="text-muted small mt-3 mb-0">Password cannot be changed from this screen.</p>
        </form>
    </div>
</div>
