@model List<LMS.Models.DTOs.User.EditUserDto>

@{
    ViewData["Title"] = "Managers";
}

<div class="lms-topbar">
    <div>
        <h1 class="lms-page-title">Managers</h1>
        <div class="lms-page-sub">Create and manage manager accounts</div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-header">Create new Manager</div>
    <div class="card-body">
        <form asp-action="CreateManager" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <input name="FullName" placeholder="Full Name" class="form-control" required />
            </div>
            <div class="col-md-3">
                <input name="Email" type="email" placeholder="Email" class="form-control" required />
            </div>
            <div class="col-md-3">
                <input name="Password" type="password" placeholder="Password" class="form-control" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Create Manager</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">All Managers (@Model.Count)</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="p-4 text-muted mb-0 text-center">No managers yet. Create one above.</p>
        }
        else
        {
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="lms-avatar" style="width:30px;height:30px;font-size:.75rem;">
                                    @(string.IsNullOrEmpty(m.FullName) ? "?" : m.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <span>@m.FullName</span>
                            </div>
                        </td>
                        <td class="text-muted">@m.Email</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="EditManager" asp-route-id="@m.Id">Edit</a>

                            <form asp-action="DeleteManager" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this manager?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
