@model LMS.Models.DTOs.Auth.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - LMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="lms-public-bg">
    <div class="lms-login-card">

        <div class="lms-login-brand">
            <div class="lms-brand-logo">L</div>
            <div>
                <div style="font-weight:700; font-size:1.15rem;">Lead Management</div>
                <div style="font-size:.8rem; color:var(--lms-muted);">Sign in to your account</div>
            </div>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="username"
                       placeholder="you@company.com" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control"
                       autocomplete="current-password" placeholder="••••••••" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign in</button>

            <div asp-validation-summary="All" class="text-danger mt-3 small"></div>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            Demo: <code>admin@lms.com</code> / <code>Admin@123</code>
        </p>
    </div>
</div>

</body>
</html>
