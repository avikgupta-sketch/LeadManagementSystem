<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LMS.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="bg-dark text-white p-3" style="width: 240px; min-height: 100vh;">
            <h4 class="mb-4">LMS</h4>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link text-white" asp-controller="User" asp-action="Managers">Managers</a>
            }

            @if (User.IsInRole("Manager"))
            {
                <a class="nav-link text-white" asp-controller="User" asp-action="Agents">My Agents</a>
                <a class="nav-link text-white" asp-controller="Lead" asp-action="Index">Leads</a>
                <a class="nav-link text-white" asp-controller="Lead" asp-action="Create">Create Lead</a>
            }

            @if (User.IsInRole("Agent"))
            {
                <a class="nav-link text-white" asp-controller="Lead" asp-action="MyLeads">My Leads</a>
                <a class="nav-link text-white" asp-controller="Lead" asp-action="Create">Create Lead</a>
            }

            <hr />

            @if (User.Identity?.IsAuthenticated == true)
            {
                <p class="small">Hi @User.Identity.Name</p>

                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger w-100">Logout</button>
                </form>
            }

        </div>

        <!-- Main -->
        <div class="p-4 w-100">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
